{
  "name": "delivery-hub-api",
  "version": "1.0.0",
  "description": "Backend REST API for managing delivery orders, drivers, and customers",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:schema": "psql $DATABASE_URL -f schema.sql",
    "db:seed": "node scripts/seed-owner.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  }
}